# Supabase — get these from your Supabase project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used by Cloudflare Pages Functions (server-side) — set in Cloudflare dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional local/frontend override. Leave unset on Cloudflare Pages to use /api.
VITE_API_BASE_URL=/api

# Used by the scraper only — set as GitHub Actions secrets
SUPABASE_SERVICE_KEY=your-service-role-key
